# ==========================================
#  CREDENCIALES DE BASE DE DATOS (PostgreSQL)
# ==========================================
# Host es el nombre del contenedor de BD en docker-compose
DB_HOST=dressme-db
DB_PORT=5432
DB_NAME=dressmedb
DB_USER=user_admin
DB_PASSWORD=password123

# ==========================================
